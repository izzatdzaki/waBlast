# waBlast Docker Environment Configuration
# Copy this file to .env.docker and adjust values as needed

# Laravel Configuration
APP_NAME=waBlast
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sikmasyita
DB_USERNAME=client
DB_PASSWORD=Masyita@123
DB_ROOT_PASSWORD=root

# Cache & Session Configuration
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
QUEUE_DRIVER=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail Configuration (using Mailhog for testing)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@wablast.local"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp/Baileys Configuration
BAILEYS_API_URL=http://baileys:3000
URL_WA_SERVER=http://baileys:3000
WA_RETRY_ATTEMPTS=3
WA_RETRY_DELAY=60
WA_TIMEOUT=30

# Node.js Baileys Backend
NODE_ENV=production
PORT=3000
API_KEY=your_secure_api_key_here
LARAVEL_SERVER_URL=http://nginx:80
WHATSAPP_STORE_PATH=./sessions
MAX_RECONNECT_RETRIES=5

# MySQL Root Password (for development)
MYSQL_ROOT_PASSWORD=root

# Memcached (if needed)
MEMCACHED_HOST=127.0.0.1
